# =============================================================================
# .gitignore for budget_book_codex (Spring Boot + Vite/React monorepo)
# 작성 원칙:
#  - 빌드 산출물/캐시/IDE 설정/로컬 데이터/민감정보는 절대 커밋하지 않는다.
#  - 다중 OS, 다중 IDE 환경을 모두 가정한다.
#  - 항목별로 그룹화하여 유지보수성을 높인다.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 운영체제(OS) 메타 파일
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# -----------------------------------------------------------------------------
# 2. IDE / 에디터 설정
#    - 팀 공유가 필요한 설정은 .vscode/settings.json 등 명시적으로 화이트리스트 처리할 것.
# -----------------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
*~
.project
.classpath
.settings/
.factorypath
nbproject/

# -----------------------------------------------------------------------------
# 3. 민감정보 / 자격증명 (커밋 금지)
#    - .env 파일은 .env.example 형태로만 커밋한다.
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
credentials*.json
secrets/
secret.*.yml
secret.*.yaml
application-secret.*
application-prod.yml
application-prod.yaml
application-local.yml
application-local.yaml

# -----------------------------------------------------------------------------
# 4. 로그 / 임시 파일
# -----------------------------------------------------------------------------
logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pid
*.pid
*.seed
*.pid.lock
tmp/
temp/
*.tmp
*.bak
*.orig

# -----------------------------------------------------------------------------
# 5. Backend: Java / Spring Boot / Gradle
# -----------------------------------------------------------------------------
# Gradle
backend/.gradle/
backend/build/
backend/!gradle/wrapper/gradle-wrapper.jar
backend/out/
backend/bin/
.gradle/
.gradle-cache/
build/
out/
# Maven (혹시 사용 시)
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
# JVM
*.class
hs_err_pid*
replay_pid*
# H2 / 로컬 DB 데이터
backend/data/
backend/*.db
backend/*.mv.db
backend/*.trace.db
*.mv.db
*.trace.db

# -----------------------------------------------------------------------------
# 6. Frontend: Node / Vite / React
# -----------------------------------------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/dev-dist/
frontend/.vite/
frontend/coverage/
frontend/.next/
frontend/.nuxt/
frontend/.cache/
frontend/.parcel-cache/
node_modules/
dist/
dev-dist/
.vite/
coverage/
.eslintcache
.stylelintcache
# Vite PWA / Workbox 빌드 산출물
sw.js
workbox-*.js
# 패키지 매니저 부산물
.pnp.*
.yarn/cache
.yarn/install-state.gz

# -----------------------------------------------------------------------------
# 7. 테스트 / 커버리지 산출물
# -----------------------------------------------------------------------------
*.lcov
.nyc_output/
junit.xml
test-results/
playwright-report/

# -----------------------------------------------------------------------------
# 8. 패키지 산출물 / 아카이브
# -----------------------------------------------------------------------------
*.jar
!gradle/wrapper/gradle-wrapper.jar
!**/gradle/wrapper/gradle-wrapper.jar
*.war
*.ear
*.nar
*.zip
*.tar
*.tar.gz
*.tgz
*.rar

# -----------------------------------------------------------------------------
# 9. 로컬 개발 도구 / 런타임 (로컬 머신에 내려받은 JDK/Node 등은 커밋하지 않음)
#    - tools/ 폴더 자체는 추적하되, 내부의 다운로드된 런타임은 무시한다.
#    - 필요 시 tools/README.md 같은 안내 문서만 화이트리스트로 허용한다.
# -----------------------------------------------------------------------------
tools/node-*/
tools/jdk-*/
tools/jre-*/
tools/*.tar.gz
tools/*.zip

# -----------------------------------------------------------------------------
# 10. 기타 도구 캐시
# -----------------------------------------------------------------------------
.history/
.terraform/
*.tfstate
*.tfstate.*
.python-version
__pycache__/
*.pyc
