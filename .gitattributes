# =============================================================================
# .gitattributes
# - 줄바꿈(EOL) 정규화: 크로스플랫폼(Windows/macOS/Linux) 협업 시 LF 통일
# - 바이너리 파일은 diff/merge에서 텍스트로 처리되지 않도록 명시
# =============================================================================

# 기본: 텍스트 자동 인식, LF로 정규화
* text=auto eol=lf

# 셸 스크립트 / Gradle wrapper는 항상 LF
*.sh        text eol=lf
gradlew     text eol=lf

# Windows 전용 파일은 CRLF 유지
*.bat       text eol=crlf
*.cmd       text eol=crlf

# 바이너리 (diff 비활성화)
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.jar       binary
*.woff      binary
*.woff2     binary
